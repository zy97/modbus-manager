{
  "openapi": "3.0.3",
  "info": {
    "title": "Modbus Manager API",
    "description": "HTTP API for the Modbus manager service.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseString"
                }
              }
            }
          }
        }
      }
    },
    "/api/conveyor/write": {
      "post": {
        "tags": ["Conveyor"],
        "summary": "Write to a conveyor route",
        "operationId": "writeConveyor",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConveyorWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Write succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConveyorWriteResponseWrapper"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/api/conveyor/write-success": {
      "get": {
        "tags": ["Conveyor"],
        "summary": "Read send success check values",
        "operationId": "writeSuccess",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Read values",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseU16Array"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/api/conveyor/can-putdown": {
      "get": {
        "tags": ["Conveyor"],
        "summary": "Read can-putdown check values",
        "operationId": "canPutdown",
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Read values",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseU16Array"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/api/conveyor/need-putdown": {
      "post": {
        "tags": ["Conveyor"],
        "summary": "Write need-putdown route",
        "operationId": "needPutdown",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConveyorNeedPutdownRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Write succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConveyorNeedPutdownResponseWrapper"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseString": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["success", "message"]
      },
      "ApiResponseU16Array": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["success", "message"]
      },
      "ConveyorWriteRequest": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          }
        },
        "required": ["source", "destination"]
      },
      "ConveyorWriteResponse": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "device": {
            "type": "string"
          },
          "slave_id": {
            "type": "integer"
          },
          "function": {
            "type": "string"
          },
          "register_address": {
            "type": "integer"
          },
          "value": {
            "type": "integer"
          }
        },
        "required": [
          "source",
          "destination",
          "device",
          "slave_id",
          "function",
          "register_address",
          "value"
        ]
      },
      "ConveyorWriteResponseWrapper": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/ConveyorWriteResponse"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["success", "message"]
      },
      "ConveyorNeedPutdownRequest": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string"
          }
        },
        "required": ["location"]
      },
      "ConveyorNeedPutdownResponse": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string"
          },
          "device": {
            "type": "string"
          },
          "slave_id": {
            "type": "integer"
          },
          "function": {
            "type": "string"
          },
          "register_address": {
            "type": "integer"
          },
          "value": {
            "type": "integer"
          }
        },
        "required": [
          "location",
          "device",
          "slave_id",
          "function",
          "register_address",
          "value"
        ]
      },
      "ConveyorNeedPutdownResponseWrapper": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/ConveyorNeedPutdownResponse"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["success", "message"]
      }
    }
  }
}
